health:hrvMax a owl:DatatypeProperty ;
    rdfs:label "Maximum HRV"@en ;
    rdfs:comment "Highest HRV reading in the period (ms)."@en ;
    rdfs:domain health:HRVStatistics ;
    rdfs:range xsd:double ;
