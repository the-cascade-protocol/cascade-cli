{
  "rule": "apple-health-daily-aggregate",
  "ruleVersion": "2",
  "supersededRuleVersions": ["1"],
  "idSpace": "healthkit",
  "valueDecimals": 4,
  "metrics": [
    {
      "hkType": "HKQuantityTypeIdentifierStepCount",
      "record": "activitySnapshot",
      "property": "steps",
      "unit": "steps",
      "sourceUnits": { "count": 1 },
      "statistics": ["sum"],
      "file": "activity"
    },
    {
      "hkType": "HKQuantityTypeIdentifierHeartRate",
      "record": "vitalReading",
      "snomed": "364075005",
      "loinc": "8867-4",
      "unit": "bpm",
      "sourceUnits": { "count/min": 1 },
      "statistics": ["minimum", "average", "maximum"],
      "file": "heart-rate"
    },
    {
      "hkType": "HKQuantityTypeIdentifierRestingHeartRate",
      "record": "vitalReading",
      "snomed": "364075005",
      "loinc": "40443-4",
      "unit": "bpm",
      "sourceUnits": { "count/min": 1 },
      "statistics": ["average"],
      "file": "heart-rate"
    },
    {
      "hkType": "HKQuantityTypeIdentifierWalkingHeartRateAverage",
      "record": "vitalReading",
      "snomed": "364075005",
      "loinc": "89270-3",
      "unit": "bpm",
      "sourceUnits": { "count/min": 1 },
      "statistics": ["average"],
      "file": "heart-rate"
    },
    {
      "hkType": "HKQuantityTypeIdentifierHeartRateVariabilitySDNN",
      "record": "vitalReading",
      "snomed": "80404004",
      "loinc": "80404-7",
      "unit": "ms",
      "sourceUnits": { "ms": 1 },
      "statistics": ["average"],
      "file": "hrv"
    },
    {
      "hkType": "HKQuantityTypeIdentifierRespiratoryRate",
      "record": "vitalReading",
      "snomed": "86290005",
      "loinc": "9279-1",
      "unit": "breaths/min",
      "sourceUnits": { "count/min": 1 },
      "statistics": ["average"],
      "file": "body-measurements"
    },
    {
      "hkType": "HKQuantityTypeIdentifierOxygenSaturation",
      "record": "vitalReading",
      "snomed": "431314004",
      "loinc": "2708-6",
      "unit": "%",
      "sourceUnits": { "%": 100 },
      "statistics": ["average"],
      "file": "body-measurements"
    },
    {
      "hkType": "HKQuantityTypeIdentifierBodyMass",
      "record": "vitalReading",
      "snomed": "27113001",
      "loinc": "29463-7",
      "unit": "kg",
      "sourceUnits": { "kg": 1, "g": 0.001, "lb": 0.45359237 },
      "statistics": ["average"],
      "file": "body-measurements"
    },
    {
      "hkType": "HKQuantityTypeIdentifierActiveEnergyBurned",
      "record": "activitySnapshot",
      "property": "activeEnergyKcal",
      "unit": "kcal",
      "sourceUnits": { "kcal": 1, "Cal": 1, "kJ": 0.2390057361 },
      "statistics": ["sum"],
      "file": "activity"
    },
    {
      "hkType": "HKQuantityTypeIdentifierBasalEnergyBurned",
      "record": "activitySnapshot",
      "property": "basalEnergyKcal",
      "unit": "kcal",
      "sourceUnits": { "kcal": 1, "Cal": 1, "kJ": 0.2390057361 },
      "statistics": ["sum"],
      "file": "activity"
    }
  ],
  "readings": [
    {
      "hkType": "HKQuantityTypeIdentifierVO2Max",
      "record": "vitalSignReading",
      "snomed": "251880009",
      "unit": "mL/kg/min",
      "sourceUnits": { "mL/min·kg": 1, "mL/kg/min": 1, "mL/(kg·min)": 1 },
      "file": "body-measurements",
      "method": {
        "metadataKey": "HKVO2MaxTestType",
        "values": {
          "1": "healthkit:maxExercise",
          "2": "healthkit:predictionSubMaxExercise",
          "3": "healthkit:predictionNonExercise",
          "4": "healthkit:predictionStepTest"
        }
      }
    }
  ],
  "bloodPressure": {
    "correlationType": "HKCorrelationTypeIdentifierBloodPressure",
    "systolicType": "HKQuantityTypeIdentifierBloodPressureSystolic",
    "diastolicType": "HKQuantityTypeIdentifierBloodPressureDiastolic",
    "snomed": "75367002",
    "loinc": "85354-9",
    "unit": "mmHg",
    "sourceUnits": { "mmHg": 1 },
    "file": "blood-pressure",
    "pairing": { "rule": "apple-health-bp-pairing", "ruleVersion": "1" }
  },
  "sleep": {
    "hkType": "HKCategoryTypeIdentifierSleepAnalysis",
    "rule": "apple-health-sleep-session",
    "ruleVersion": "1",
    "gapMinutes": 60,
    "awakeRunMinutes": 60,
    "file": "sleep",
    "stages": {
      "HKCategoryValueSleepAnalysisInBed": "inBedMinutes",
      "HKCategoryValueSleepAnalysisAwake": "awakeMinutes",
      "HKCategoryValueSleepAnalysisAsleepCore": "lightSleepMinutes",
      "HKCategoryValueSleepAnalysisAsleepDeep": "deepSleepMinutes",
      "HKCategoryValueSleepAnalysisAsleepREM": "remSleepMinutes",
      "HKCategoryValueSleepAnalysisAsleepUnspecified": "asleepUnspecifiedMinutes",
      "HKCategoryValueSleepAnalysisAsleep": "asleepUnspecifiedMinutes"
    }
  },
  "activitySummary": {
    "file": "activity",
    "sourceName": "ActivitySummary",
    "energyUnits": { "kcal": 1, "Cal": 1, "kJ": 0.2390057361 },
    "earliestDate": "1970-01-01"
  },
  "workouts": {
    "file": "activity",
    "durationUnits": { "min": 1, "s": 0.016666666666666666, "hr": 60 },
    "distanceUnits": { "m": 1, "km": 1000, "mi": 1609.344, "ft": 0.3048, "yd": 0.9144 },
    "energyUnits": { "kcal": 1, "Cal": 1, "kJ": 0.2390057361 }
  },
  "devices": {
    "file": "wellness-devices"
  },
  "retiredReadingCodes": [
    {
      "loinc": "41981-2",
      "file": "activity",
      "why": "Before per-device active energy moved to health:activeEnergyKcal on a DailyActivitySnapshot it was written as a DailyVitalReading coded only with this code. A reading written that way stays filed where it was written."
    }
  ]
}
